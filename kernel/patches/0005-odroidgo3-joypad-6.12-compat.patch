+/*
+ * mainline 6.12 removed of_get_named_gpio_flags()/enum of_gpio_flags;
+ * read the specifier flags ourselves and return the legacy gpio number.
+ */
+static int joypad_of_get_gpio(const struct device_node *np, const char *name,
+			      unsigned int *flags)
+{
+	struct of_phandle_args args;
+	int ret;
+
+	ret = of_parse_phandle_with_args(np, name, "#gpio-cells", 0, &args);
+	if (ret)
+		return ret;
+
+	*flags = (args.args_count > 1) ? args.args[1] : 0;
+	of_node_put(args.np);
+
+	return of_get_named_gpio(np, name, 0);
+}
