#!/usr/bin/env python3
"""treeos-import: 把 /roms/import/ 里的文件整理进对应游戏目录。

用户只做一件事：把游戏文件或整个文件夹拖进 /roms/import/（卡插电脑即可见），
开机前由 treeos-import.service 自动归档；也可以手动运行。

不下载、不内置任何游戏；只搬运用户自己提供的文件。

用法:
  treeos-import                # 处理 $TREEOS_ROM_ROOT/import（默认 /roms/import）
  TREEOS_ROM_ROOT=/tmp/x treeos-import   # 测试
"""
import os
import re
import shutil
import sys
import tempfile
import time
import zipfile

ROOT = os.environ.get("TREEOS_ROM_ROOT", "/roms")
IMPORT = os.path.join(ROOT, "import")
REPORT = os.path.join(ROOT, "import-report.txt")
FLASH_DIR = os.path.join(ROOT, "flash")
PORTS_DIR = os.path.join(ROOT, "ports")
FLASH_RUNNER = "/usr/local/bin/treeos-flash"

# 扩展名 -> 目录
ROM_EXT = {
    ".gba": "gba", ".gb": "gb", ".gbc": "gbc",
    ".nes": "nes", ".fds": "fds",
    ".sfc": "snes", ".smc": "snes",
    ".md": "megadrive", ".gen": "megadrive",
    ".n64": "n64", ".z64": "n64", ".v64": "n64",
    ".cue": "psx", ".chd": "psx",
    ".iso": "psx", ".img": "psx",
    ".cso": "psp", ".pbp": "psp",
    ".nds": "nds",
    ".pce": "pcengine", ".ws": "wonderswan", ".wsc": "wonderswancolor",
    ".ngp": "ngp", ".ngc": "ngpc",
    ".32x": "sega32x", ".sms": "mastersystem", ".gg": "gamegear",
    ".a26": "atari2600", ".a78": "atari7800",
    ".lnx": "atarilynx", ".vb": "virtualboy",
}

# import/ 下用平台名做子目录时，整包按这个平台放（解决 .iso/.pbp 歧义）
PLATFORM_ALIASES = {
    "gba": "gba", "gb": "gb", "gbc": "gbc",
    "nes": "nes", "fc": "nes", "famicom": "nes",
    "snes": "snes", "sfc": "snes", "superfamicom": "snes",
    "md": "megadrive", "megadrive": "megadrive", "genesis": "megadrive",
    "gg": "gamegear", "gamegear": "gamegear",
    "nds": "nds", "n64": "n64",
    "arcade": "arcade", "mame": "arcade", "fbneo": "arcade",
    "psx": "psx", "ps1": "psx", "ps": "psx", "playstation": "psx",
    "psp": "psp", "ppsspp": "psp",
}

# 单文件就能直接丢进平台目录的扩展名
SINGLE_FILE_ROM = {
    ".gba", ".gb", ".gbc", ".nes", ".fds", ".sfc", ".smc",
    ".md", ".gen", ".n64", ".z64", ".v64", ".nds", ".pce",
    ".ws", ".wsc", ".ngp", ".ngc", ".32x", ".sms", ".gg",
    ".a26", ".a78", ".lnx", ".vb", ".iso", ".cso", ".pbp",
    ".chd", ".img",
}
FLASH_ENTRY_NAMES = ("index.swf", "main.swf", "start.swf",
                     "game.swf", "loader.swf", "play.swf")

lines = []
counts = {"rom": 0, "flash": 0, "package": 0, "skip": 0, "unknown": 0, "error": 0}


def log(msg):
    lines.append(msg)
    print(msg)


def safe(name):
    name = os.path.basename(name.replace("\\", "/")).strip()
    name = re.sub(r'[\x00-\x1f<>:"|?*]', "", name)
    return name or "unnamed"


def zip_name(info):
    """还原 Windows 中文 zip 的 GBK 文件名。"""
    if info.flag_bits & 0x800:
        return info.filename
    try:
        return info.filename.encode("cp437").decode("gbk")
    except (UnicodeEncodeError, UnicodeDecodeError):
        return info.filename


def ensure_dir(path):
    os.makedirs(path, exist_ok=True)
    return path


def target_dir(ext):
    sub = ROM_EXT.get(ext.lower())
    return os.path.join(ROOT, sub) if sub else None


def move_rom(path, ext):
    sub = ROM_EXT.get(ext.lower())
    if not sub:
        counts["unknown"] += 1
        log(f"[跳过] 不认识的扩展名: {os.path.basename(path)}")
        return False
    dest_dir = ensure_dir(os.path.join(ROOT, sub))
    dest = os.path.join(dest_dir, safe(os.path.basename(path)))
    if os.path.exists(dest):
        counts["skip"] += 1
        log(f"[已存在] {sub}/{os.path.basename(dest)}")
        return False
    shutil.move(path, dest)
    counts["rom"] += 1
    log(f"[游戏] {os.path.basename(path)} -> {sub}/")
    return True


def find_entry(folder):
    lower = {f.lower(): f for f in os.listdir(folder)
             if os.path.isfile(os.path.join(folder, f))}
    for name in FLASH_ENTRY_NAMES:
        if name in lower:
            return os.path.join(folder, lower[name])
    swfs = [f for f in os.listdir(folder) if f.lower().endswith(".swf")
            and os.path.isfile(os.path.join(folder, f))]
    if not swfs:
        return None
    swfs.sort(key=lambda f: os.path.getsize(os.path.join(folder, f)), reverse=True)
    return os.path.join(folder, swfs[0])


def make_port(title, entry):
    ensure_dir(PORTS_DIR)
    port = os.path.join(PORTS_DIR, safe(title) + ".sh")
    if os.path.exists(port):
        counts["skip"] += 1
        log(f"[已存在] ports/{safe(title)}.sh")
        return
    entry = entry.replace('"', '\\"')
    with open(port, "w", encoding="utf-8") as f:
        f.write("#!/bin/sh\n")
        f.write(f'exec sudo -n {FLASH_RUNNER} "{entry}"\n')
    os.chmod(port, 0o755)
    log(f"[入口] ports/{safe(title)}.sh -> {os.path.basename(entry)}")


def install_flash_package(folder, title):
    dest = os.path.join(FLASH_DIR, safe(title))
    if os.path.exists(dest):
        counts["skip"] += 1
        log(f"[已存在] flash/{safe(title)}/")
        return
    ensure_dir(FLASH_DIR)
    shutil.move(folder, dest)
    entry = find_entry(dest)
    if not entry:
        counts["error"] += 1
        log(f"[失败] flash/{safe(title)}/ 里没有 .swf")
        return
    counts["package"] += 1
    log(f"[Flash 包] flash/{safe(title)}/ 入口 {os.path.basename(entry)}")
    make_port(os.path.splitext(safe(title))[0], entry)


def install_swf(path, title):
    ensure_dir(FLASH_DIR)
    dest = os.path.join(FLASH_DIR, safe(title) + ".swf")
    if os.path.exists(dest):
        counts["skip"] += 1
        log(f"[已存在] flash/{safe(title)}.swf")
        return
    shutil.move(path, dest)
    counts["flash"] += 1
    log(f"[Flash] {os.path.basename(dest)} -> flash/")


def process_dir(folder, title):
    files = [f for f in os.listdir(folder)
             if os.path.isfile(os.path.join(folder, f))]
    swfs = [f for f in files if f.lower().endswith(".swf")]
    if swfs:
        install_flash_package(folder, title)
        return
    moved = False
    for f in files:
        ext = os.path.splitext(f)[1].lower()
        if ext in ROM_EXT and ROM_EXT[ext]:
            move_rom(os.path.join(folder, f), ext)
            moved = True
        elif ext == ".zip":
            process_zip(os.path.join(folder, f), os.path.splitext(f)[0])
            moved = True
        else:
            counts["unknown"] += 1
            log(f"[跳过] {f}")
    if not moved:
        log(f"[提示] {title} 里没有可识别的游戏文件")


def extract_zip(zpath, tmp):
    with zipfile.ZipFile(zpath) as z:
        for info in z.infolist():
            name = zip_name(info)
            parts = [safe(p) for p in name.split("/") if p not in ("", ".", "..")]
            if not parts:
                continue
            out = os.path.join(tmp, *parts)
            if info.is_dir():
                ensure_dir(out)
                continue
            ensure_dir(os.path.dirname(out))
            with z.open(info) as src, open(out, "wb") as dst:
                shutil.copyfileobj(src, dst)


def platform_hint(name):
    key = os.path.splitext(name)[0].lower().strip()
    return PLATFORM_ALIASES.get(key) or PLATFORM_ALIASES.get(name.lower().strip())


def install_platform_dir(folder, platform, title):
    """import/<平台名>/ 整包按平台放，不猜扩展名。"""
    dest_root = ensure_dir(os.path.join(ROOT, platform))
    n = 0
    for entry in sorted(os.listdir(folder)):
        src = os.path.join(folder, entry)
        dest = os.path.join(dest_root, safe(entry))
        if os.path.exists(dest):
            counts["skip"] += 1
            log(f"[已存在] {platform}/{safe(entry)}")
            continue
        shutil.move(src, dest)
        n += 1
    counts["rom"] += n
    log(f"[平台] {title}/ -> {platform}/（{n} 项）")


def process_zip(zpath, title):
    tmp = tempfile.mkdtemp(prefix=".treeos-import-", dir=IMPORT)
    try:
        with zipfile.ZipFile(zpath) as z:
            names = [zip_name(i) for i in z.infolist() if not i.is_dir()]
        low = [n.lower() for n in names]

        # 1) 含 SWF：Flash 包
        if any(n.endswith(".swf") for n in low):
            extract_zip(zpath, tmp)
            entries = [e for e in os.listdir(tmp) if not e.startswith(".")]
            if len(entries) == 1 and os.path.isdir(os.path.join(tmp, entries[0])):
                process_dir(os.path.join(tmp, entries[0]), title)
            else:
                process_dir(tmp, title)
            os.unlink(zpath)
            return

        # 2) 选目标平台
        target = None
        if any(n.endswith(".cue") for n in low):
            target = "psx"
        else:
            for n in low:
                ext = os.path.splitext(n)[1]
                if ext in ROM_EXT and ROM_EXT[ext]:
                    target = ROM_EXT[ext]
                    break

        # 3) 没有已知平台：按街机处理，zip 原样保留
        if target is None:
            dest_root = ensure_dir(os.path.join(ROOT, "arcade"))
            dest = os.path.join(dest_root, safe(title) + ".zip")
            if os.path.exists(dest):
                counts["skip"] += 1
                log(f"[已存在] arcade/{safe(title)}.zip")
            else:
                shutil.move(zpath, dest)
                counts["rom"] += 1
                log(f"[街机] {safe(title)}.zip 原样保留 -> arcade/")
            return

        extract_zip(zpath, tmp)
        entries = [e for e in os.listdir(tmp) if not e.startswith(".")]
        if len(entries) == 1 and os.path.isdir(os.path.join(tmp, entries[0])):
            src = os.path.join(tmp, entries[0])
        else:
            src = tmp
        files = [f for f in os.listdir(src) if os.path.isfile(os.path.join(src, f))]
        dest_root = ensure_dir(os.path.join(ROOT, target))
        # 多文件（cue+bin、PSP 目录结构）：整包放子目录
        if len(files) != 1 or any(f.lower().endswith(".cue") for f in files):
            dest = os.path.join(dest_root, safe(title))
            if os.path.exists(dest):
                counts["skip"] += 1
                log(f"[已存在] {target}/{safe(title)}/")
            else:
                shutil.move(src, dest)
                counts["rom"] += 1
                log(f"[压缩包] {safe(title)} -> {target}/{safe(title)}/")
        else:
            f = files[0]
            dest = os.path.join(dest_root, safe(f))
            if os.path.exists(dest):
                counts["skip"] += 1
                log(f"[已存在] {target}/{safe(f)}")
            else:
                shutil.move(os.path.join(src, f), dest)
                counts["rom"] += 1
                log(f"[压缩包] {safe(f)} -> {target}/")
        os.unlink(zpath)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def main():
    if not os.path.isdir(IMPORT):
        log(f"没有 {IMPORT}，跳过")
        return 0
    items = sorted(os.listdir(IMPORT))
    items = [i for i in items if not i.startswith(".")]
    if not items:
        log("import 目录为空")
        return 0

    log(f"TreeOS 导入 {time.strftime('%Y-%m-%d %H:%M:%S')}")
    for item in items:
        path = os.path.join(IMPORT, item)
        title = os.path.splitext(item)[0]
        try:
            if os.path.isdir(path):
                hint = platform_hint(item)
                if hint:
                    install_platform_dir(path, hint, title)
                else:
                    process_dir(path, title)
                if os.path.isdir(path) and not os.listdir(path):
                    os.rmdir(path)
            else:
                ext = os.path.splitext(item)[1].lower()
                if ext == ".zip":
                    process_zip(path, title)
                elif ext == ".swf":
                    install_swf(path, title)
                elif ext in ROM_EXT and ROM_EXT[ext]:
                    move_rom(path, ext)
                else:
                    counts["unknown"] += 1
                    log(f"[跳过] {item}（不认识的类型）")
        except Exception as e:  # noqa: BLE001 - 单个文件失败不中断整批
            counts["error"] += 1
            log(f"[失败] {item}: {e}")

    summary = (f"完成：游戏 {counts['rom']}，Flash {counts['flash']}，"
               f"Flash 包 {counts['package']}，跳过 {counts['skip']}，"
               f"不认识 {counts['unknown']}，失败 {counts['error']}")
    log(summary)
    try:
        with open(REPORT, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
    except OSError:
        pass
    return 0 if counts["error"] == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
