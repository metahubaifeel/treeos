[Unit]
Description=TreeOS DRM splash
DefaultDependencies=no
Before=treeos-emulationstation.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/bin/rm -f /dev/shm/treeos-splash-stop
ExecStart=/usr/local/bin/treeos-splash-run
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sysinit.target
