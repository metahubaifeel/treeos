+fn ngp_key(s: sdl2::keyboard::Scancode) -> Option<ruffle_core::events::KeyDescriptor> {
+    use ruffle_core::events::{KeyDescriptor, KeyLocation, LogicalKey, NamedKey, PhysicalKey as P};
+    use sdl2::keyboard::Scancode as S;
+    const LETTERS: [P;26] = [P::KeyA,P::KeyB,P::KeyC,P::KeyD,P::KeyE,P::KeyF,P::KeyG,P::KeyH,P::KeyI,P::KeyJ,P::KeyK,P::KeyL,P::KeyM,P::KeyN,P::KeyO,P::KeyP,P::KeyQ,P::KeyR,P::KeyS,P::KeyT,P::KeyU,P::KeyV,P::KeyW,P::KeyX,P::KeyY,P::KeyZ];
+    const DIGITS: [P;10] = [P::Digit1,P::Digit2,P::Digit3,P::Digit4,P::Digit5,P::Digit6,P::Digit7,P::Digit8,P::Digit9,P::Digit0];
+    let n=s as i32;
+    let (physical_key,logical_key) = if (S::A as i32..=S::Z as i32).contains(&n) {
+        let i=(n-S::A as i32) as usize; (LETTERS[i],LogicalKey::Character((b'a'+i as u8) as char))
+    } else if (S::Num1 as i32..=S::Num0 as i32).contains(&n) {
+        let i=(n-S::Num1 as i32) as usize; (DIGITS[i],LogicalKey::Character((b'0'+((i+1)%10) as u8) as char))
+    } else { match s {
+        S::Space => (P::Space,LogicalKey::Character(' ')),
+        S::Left => (P::ArrowLeft,LogicalKey::Named(NamedKey::ArrowLeft)), S::Right => (P::ArrowRight,LogicalKey::Named(NamedKey::ArrowRight)),
+        S::Up => (P::ArrowUp,LogicalKey::Named(NamedKey::ArrowUp)), S::Down => (P::ArrowDown,LogicalKey::Named(NamedKey::ArrowDown)), _=>return None,
+    }};
+    Some(KeyDescriptor { physical_key,logical_key,key_location:KeyLocation::Standard })
+}
