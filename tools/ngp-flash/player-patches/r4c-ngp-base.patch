+//! Whitelisted HTTP navigator: only hosts listed in FLASH_NETWORK_HOSTS may be
+//! fetched. Player futures keep running on the NullExecutor; only the blocking
+//! HTTP work happens on a worker thread, waking the future through a oneshot.
+
+use std::borrow::Cow;
+use std::collections::HashSet;
+use std::sync::mpsc::{self, Sender};
+use std::thread;
+
+use encoding_rs::Encoding;
+use futures::channel::oneshot;
+use indexmap::IndexMap;
+use ruffle_core::backend::navigator::{
+    ErrorResponse, NavigationMethod, NavigatorBackend, NullNavigatorBackend, OwnedFuture, Request,
+    SuccessResponse,
+};
+use ruffle_core::loader::Error as NavError;
+use ruffle_core::socket::{ConnectionState, SocketAction, SocketHandle};
+use url::{ParseError, Url};
+
+pub struct NetNavigator {
+    inner: NullNavigatorBackend,
+    allowed: HashSet<String>,
+    tx: Sender<Job>,
+}
+
+struct Job {
+    url: String,
+    method: String,
+    body: Option<(Vec<u8>, String)>,
+    reply: oneshot::Sender<Result<HttpResponse, String>>,
+}
+
+struct HttpResponse {
+    url: String,
+    status: u16,
+    bytes: Vec<u8>,
+    encoding: Option<&'static Encoding>,
+}
+
+impl SuccessResponse for HttpResponse {
+    fn url(&self) -> Cow<'_, str> {
+        Cow::Borrowed(&self.url)
+    }
+    fn body(self: Box<Self>) -> OwnedFuture<Vec<u8>, NavError> {
+        let bytes = self.bytes;
+        Box::pin(async move { Ok(bytes) })
+    }
+    fn text_encoding(&self) -> Option<&'static Encoding> {
+        self.encoding
+    }
+    fn status(&self) -> u16 {
+        self.status
+    }
+    fn redirected(&self) -> bool {
+        false
+    }
+    fn next_chunk(&mut self) -> OwnedFuture<Option<Vec<u8>>, NavError> {
+        let bytes = std::mem::take(&mut self.bytes);
+        Box::pin(async move { Ok(if bytes.is_empty() { None } else { Some(bytes) }) })
+    }
+    fn expected_length(&self) -> Result<Option<u64>, NavError> {
+        Ok(Some(self.bytes.len() as u64))
+    }
+}
+
+impl NetNavigator {
+    pub fn new(inner: NullNavigatorBackend) -> Self {
+        let allowed = std::env::var("FLASH_NETWORK_HOSTS")
+            .unwrap_or_default()
+            .split(',')
+            .map(|h| h.trim().to_ascii_lowercase())
+            .filter(|h| !h.is_empty())
+            .collect();
+        let (tx, rx) = mpsc::channel::<Job>();
+        thread::Builder::new()
+            .name("flash-http".into())
+            .spawn(move || {
+                while let Ok(job) = rx.recv() {
+                    let out = run_job(&job);
+                    let _ = job.reply.send(out);
+                }
+            })
+            .expect("spawn http worker");
+        Self { inner, allowed, tx }
+    }
+
+    pub fn allowed(&self) -> &HashSet<String> {
+        &self.allowed
+    }
+}
+
+fn run_job(job: &Job) -> Result<HttpResponse, String> {
+    let mut req = match job.method.as_str() {
+        "POST" => ureq::post(&job.url),
+        "PUT" => ureq::put(&job.url),
+        "DELETE" => ureq::delete(&job.url),
+        _ => ureq::get(&job.url),
+    };
+    let resp = match &job.body {
+        Some((data, mime)) => req.set("content-type", mime).send_bytes(data),
+        None => req.call(),
+    };
+    match resp {
+        Ok(r) => {
+            let status = r.status();
+            let final_url = r.get_url().to_string();
+            let encoding = r
+                .header("content-type")
+                .and_then(|ct| ct.split("charset=").nth(1))
+                .and_then(|cs| Encoding::for_label(cs.trim().as_bytes()));
+            let mut bytes = Vec::new();
+            use std::io::Read as _;
+            let mut reader = r.into_reader().take(64 * 1024 * 1024);
+            if let Err(e) = reader.read_to_end(&mut bytes) {
+                return Err(format!("read body: {e}"));
+            }
+            Ok(HttpResponse { url: final_url, status, bytes, encoding })
+        }
+        // ureq 2.x turns non-2xx into Error::Status; keep the body for the game.
+        Err(ureq::Error::Status(status, r)) => {
+            let final_url = r.get_url().to_string();
+            let mut bytes = Vec::new();
+            use std::io::Read as _;
+            let mut reader = r.into_reader().take(64 * 1024 * 1024);
+            let _ = reader.read_to_end(&mut bytes);
+            Ok(HttpResponse { url: final_url, status, bytes, encoding: None })
+        }
+        Err(e) => Err(format!("{e}")),
+    }
+}
+
+impl NavigatorBackend for NetNavigator {
+    fn navigate_to_url(
+        &self,
+        url: &str,
+        target: &str,
+        vars_method: Option<(NavigationMethod, IndexMap<String, String>)>,
+    ) {
+        self.inner.navigate_to_url(url, target, vars_method)
+    }
+
+    fn fetch(&self, request: Request) -> OwnedFuture<Box<dyn SuccessResponse>, ErrorResponse> {
+        let raw = request.url().to_string();
+        let url = match self.resolve_url(&raw) {
+            Ok(u) => u,
+            Err(e) => {
+                return Box::pin(async move {
+                    Err(ErrorResponse {
+                        url: raw,
+                        error: NavError::FetchError(format!("bad url: {e}").into()),
+                    })
+                })
+            }
+        };
+        let host = url.host_str().unwrap_or("").to_ascii_lowercase();
+        let remote = matches!(url.scheme(), "http" | "https");
+        if !remote || !self.allowed.contains(&host) {
+            // Local files and non-whitelisted hosts keep the old behaviour.
+            return self.inner.fetch(request);
+        }
+        let method = match request.method() {
+            NavigationMethod::Get => "GET",
+            NavigationMethod::Post => "POST",
+        };
+        let body = request.body().clone();
+        let (reply, wait) = oneshot::channel();
+        let job = Job { url: url.to_string(), method: method.to_string(), body, reply };
+        if self.tx.send(job).is_err() {
+            let shown = url.to_string();
+            return Box::pin(async move {
+                Err(ErrorResponse {
+                    url: shown,
+                    error: NavError::FetchError("http worker gone".into()),
+                })
+            });
+        }
+        let shown = url.to_string();
+        Box::pin(async move {
+            match wait.await {
+                Ok(Ok(resp)) => Ok(Box::new(resp) as Box<dyn SuccessResponse>),
+                Ok(Err(msg)) => Err(ErrorResponse {
+                    url: shown,
+                    error: NavError::FetchError(msg.into()),
+                }),
+                Err(_) => Err(ErrorResponse {
+                    url: shown,
+                    error: NavError::FetchError("http worker dropped".into()),
+                }),
+            }
+        })
+    }
+
+    fn resolve_url(&self, url: &str) -> Result<Url, ParseError> {
+        self.inner.resolve_url(url)
+    }
+
+    fn spawn_future(&mut self, future: OwnedFuture<(), NavError>) {
+        self.inner.spawn_future(future)
+    }
+
+    fn pre_process_url(&self, url: Url) -> Url {
+        self.inner.pre_process_url(url)
+    }
+
+    fn connect_socket(
+        &mut self,
+        host: String,
+        port: u16,
+        _timeout: std::time::Duration,
+        handle: SocketHandle,
+        _receiver: async_channel::Receiver<Vec<u8>>,
+        sender: async_channel::Sender<SocketAction>,
+    ) {
+        let _ = host;
+        let _ = port;
+        let _ = sender.try_send(SocketAction::Connect(handle, ConnectionState::Failed));
+    }
+}
+
+/// Either the plain navigator or the whitelisted one, chosen at startup.
+pub enum AnyNavigator {
+    Plain(NullNavigatorBackend),
+    Net(NetNavigator),
+}
+
+impl AnyNavigator {
+    pub fn new(inner: NullNavigatorBackend, hosts: &str) -> Self {
+        if hosts.trim().is_empty() {
+            Self::Plain(inner)
+        } else {
+            Self::Net(NetNavigator::new(inner))
+        }
+    }
+}
+
+impl NavigatorBackend for AnyNavigator {
+    fn navigate_to_url(
+        &self,
+        url: &str,
+        target: &str,
+        vars_method: Option<(NavigationMethod, IndexMap<String, String>)>,
+    ) {
+        match self {
+            Self::Plain(n) => n.navigate_to_url(url, target, vars_method),
+            Self::Net(n) => n.navigate_to_url(url, target, vars_method),
+        }
+    }
+    fn fetch(&self, request: Request) -> OwnedFuture<Box<dyn SuccessResponse>, ErrorResponse> {
+        match self {
+            Self::Plain(n) => n.fetch(request),
+            Self::Net(n) => n.fetch(request),
+        }
+    }
+    fn resolve_url(&self, url: &str) -> Result<Url, ParseError> {
+        match self {
+            Self::Plain(n) => n.resolve_url(url),
+            Self::Net(n) => n.resolve_url(url),
+        }
+    }
+    fn spawn_future(&mut self, future: OwnedFuture<(), NavError>) {
+        match self {
+            Self::Plain(n) => n.spawn_future(future),
+            Self::Net(n) => n.spawn_future(future),
+        }
+    }
+    fn pre_process_url(&self, url: Url) -> Url {
+        match self {
+            Self::Plain(n) => n.pre_process_url(url),
+            Self::Net(n) => n.pre_process_url(url),
+        }
+    }
+    fn connect_socket(
+        &mut self,
+        host: String,
+        port: u16,
+        timeout: std::time::Duration,
+        handle: SocketHandle,
+        receiver: async_channel::Receiver<Vec<u8>>,
+        sender: async_channel::Sender<SocketAction>,
+    ) {
+        match self {
+            Self::Plain(n) => n.connect_socket(host, port, timeout, handle, receiver, sender),
+            Self::Net(n) => n.connect_socket(host, port, timeout, handle, receiver, sender),
+        }
+    }
+}
